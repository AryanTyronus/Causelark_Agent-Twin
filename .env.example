# Causelark Agent Twin — environment shape.
#
# Copy to `.env.local` for local development. `.env*` files are gitignored;
# only this example is committed. Never commit real credentials or tokens.
#
# `npm run dev` and `npm run build` validate this file. On a clone without a
# provisioned database, prefix the command with SKIP_ENV_VALIDATION=1.

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional. Base origin for an external API; unset means same-origin /api.
# NEXT_PUBLIC_API_URL=

# --- Database (framework) ----------------------------------------------------
# Required by the Prisma client. Postgres is provisioned by the platform and
# injected at deploy time.
DATABASE_URL=postgresql://user:password@localhost:5432/causelark

# --- Auth (framework better-auth module) -------------------------------------
BETTER_AUTH_SECRET=replace-with-a-long-random-value
BETTER_AUTH_URL=http://localhost:3000
# BETTER_AUTH_TRUSTED_ORIGINS=
# POLSIA_OWNER_EMAIL=

# --- Agent Twin provider selection -------------------------------------------
#
# Which model provider backs the Agent Twin agent path. Selection is explicit:
# an unrecognised value fails the turn with a visible configuration error rather
# than silently switching providers. Unset defaults to `bedrock`.
#
#   bedrock     Amazon Bedrock via the Strands `BedrockModel`. The intended
#               production / AWS hackathon provider.
#   agentrouter AgentRouter via Strands' OpenAI-compatible `OpenAIModel`. A
#               DEVELOPMENT provider, for running the Agent Twin locally before
#               AWS credentials exist. Not for production.
AGENT_PROVIDER=bedrock

# --- Agent Twin provider: Strands Agents SDK on Amazon Bedrock ---------------
#
# Selected when AGENT_PROVIDER=bedrock (the default).
#
# BEDROCK_MODEL_ID is REQUIRED for this provider. There is no silent default:
# without it, an agent-step turn persists a visible `missing_configuration`
# failure instead of running a billed default model.
# Use a Bedrock model ID or an inference-profile ID available in your region,
# e.g. an `anthropic.claude-*` foundation-model ID or a `us.anthropic.*`
# cross-region inference profile.
BEDROCK_MODEL_ID=your-bedrock-model-or-inference-profile-id

# Optional. Region for the Bedrock client. Falls back to AWS_REGION, then to
# the AWS SDK's own region resolution (AWS_DEFAULT_REGION, shared config,
# instance metadata).
# BEDROCK_REGION=us-east-1
# AWS_REGION=us-east-1

# --- Agent Twin provider: AgentRouter (DEVELOPMENT ONLY) ---------------------
#
# Selected when AGENT_PROVIDER=agentrouter. Reached through the Strands SDK's
# OpenAI-compatible adapter, so tool calling, validation, persistence, metrics
# and replay are identical to the Bedrock path; only the model client differs.
#
# Placeholder only — never commit a real key. Put the real value in
# `.env.local`, which is gitignored. The key is read server-side only and is
# never sent to the browser, persisted with a turn, or written to a log.
# AGENTROUTER_API_KEY=your-agentrouter-api-key
#
# Optional. Endpoint base; the client appends `/chat/completions`. Defaults to
# https://agentrouter.org/v1. Configurable so an operator can point elsewhere.
# AGENTROUTER_BASE_URL=https://agentrouter.org/v1
#
# Optional. Model served through AgentRouter. Defaults to deepseek-v4-flash.
# AGENTROUTER_MODEL=deepseek-v4-flash

# --- AWS credentials ---------------------------------------------------------
#
# DO NOT put AWS credentials in this file, and never commit them. The AWS SDK
# resolves credentials through its standard credential provider chain:
#
#   1. AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_SESSION_TOKEN (env)
#   2. AWS_PROFILE / ~/.aws/credentials and ~/.aws/config
#   3. SSO, container credentials, EC2/ECS instance metadata, web identity
#
# The identity needs `bedrock:InvokeModel` and
# `bedrock:InvokeModelWithResponseStream` on the configured model, and model
# access must be granted for that model in the Bedrock console for the region.
#
# For a named local profile, point the SDK at it instead of copying secrets:
# AWS_PROFILE=my-bedrock-profile

# --- Framework `ai` module (unrelated to the Agent Twin) ---------------------
# Still used by src/lib/ai/client.ts and src/app/api/ai/chat/route.ts. The
# Agent Twin agent path does not read these.
# POLSIA_AI_BASE_URL=https://polsia.com/ai/openai/v1
# POLSIA_API_KEY=
# POLSIA_API_TOKEN=
